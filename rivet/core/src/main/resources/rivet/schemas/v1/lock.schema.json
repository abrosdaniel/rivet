{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/abrosdaniel/rivet/HEAD/rivet/core/src/main/resources/rivet/schemas/v1/lock.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "maxItems": 20
        },
        "repository": {
          "type": "string",
          "pattern": "^https://",
          "maxLength": 2048
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "authors",
        "repository"
      ]
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
        },
        "createdAt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "sourceCommit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "updatePolicy": {
          "enum": [
            "required",
            "recommended"
          ]
        }
      },
      "required": [
        "version",
        "createdAt",
        "sourceCommit",
        "updatePolicy"
      ]
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "kind": {
            "enum": [
              "required",
              "recommended",
              "optional"
            ]
          },
          "category": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
            },
            "maxItems": 2000,
            "uniqueItems": true
          },
          "conflicts": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
            },
            "maxItems": 2000,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "kind",
          "category",
          "dependencies",
          "conflicts"
        ]
      },
      "maxItems": 2000
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "componentId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 8589934592
          },
          "policy": {
            "enum": [
              "enforce",
              "update",
              "preserve"
            ]
          },
          "urls": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^https://",
              "maxLength": 2048
            }
          }
        },
        "required": [
          "componentId",
          "path",
          "version",
          "urls",
          "sha256",
          "size",
          "policy"
        ]
      },
      "maxItems": 10000
    },
    "content": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "type": {
            "enum": [
              "rules",
              "news",
              "changelog",
              "asset"
            ]
          },
          "url": {
            "type": "string",
            "pattern": "^https://",
            "maxLength": 2048
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "date": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "locale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "required": [
          "id",
          "type",
          "url",
          "sha256",
          "size"
        ]
      },
      "maxItems": 10000
    },
    "minecraft": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "loader": {
          "const": "neoforge"
        },
        "loaderVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "version",
        "loader",
        "loaderVersion"
      ]
    },
    "rivet": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^((0|[1-9][0-9]*)\\.(x(\\.x)?|(0|[1-9][0-9]*)\\.(x|0|[1-9][0-9]*))|=(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)|>=(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*) <(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*))$",
          "description": "Release family (1.x), explicit bounded range (>=1.1.0 <2.0.0) or exact release (=1.1.0). Legacy 1.x.x, 1.1.x and bare 1.1.0 remain supported.",
          "x-patternMessage": "Укажите требование Rivet: 1.x, >=1.1.0 <2.0.0 или =1.1.0. Старые 3.4.x и A.B.C также поддерживаются.",
          "x-rivetRequirement": true
        }
      },
      "required": [
        "version"
      ]
    },
    "policies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "customFiles": {
          "enum": [
            "warn",
            "deny"
          ]
        }
      },
      "required": [
        "customFiles"
      ]
    },
    "servers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "address": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "required": [
          "id",
          "name",
          "address"
        ]
      },
      "maxItems": 1,
      "minItems": 1
    },
    "integrations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "luckperms": {
          "type": "boolean"
        }
      },
      "required": [
        "luckperms"
      ]
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "accent": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "icon": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "logo": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "banner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": []
    }
  },
  "required": [
    "schemaVersion",
    "project",
    "release",
    "minecraft",
    "rivet",
    "policies",
    "servers",
    "integrations",
    "theme",
    "components",
    "files",
    "content"
  ]
}
